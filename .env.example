# ---- REQUIRED ----
# PostgreSQL connection string (free options: Neon, Supabase). Example:
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Session signing secret, 32+ chars.   openssl rand -base64 48
AUTH_SECRET=""
# 32-byte key for encrypting Aadhaar numbers.   openssl rand -base64 32
DATA_ENCRYPTION_KEY=""

# ---- OPTIONAL ----
# Principal's first password when seeding (otherwise a random one is generated)
ADMIN_INITIAL_PASSWORD=""
# Real SMS (OTP / reminders) via Fast2SMS. Without it SMS is only printed in dev and FAILS in production.
FAST2SMS_API_KEY=""
# Secret for the hourly reminder job: GET /api/cron/reminders with "Authorization: Bearer <secret>"
CRON_SECRET=""
# AI doubt solver / career mentor
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
APP_URL=""
